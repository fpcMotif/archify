{
  "name": "schematics",
  "version": "3.2.0",
  "private": true,
  "type": "module",
  "description": "JSON-IR diagram renderers (architecture / workflow / sequence / dataflow / lifecycle / erd / class / tree / timeline / waterfall).",
  "license": "Apache-2.0",
  "bin": {
    "schematics": "./bin/schematics.ts"
  },
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "generate:viewer": "bun ../scripts/generate-viewer.ts",
    "check:viewer": "bun ../scripts/generate-viewer.ts --check",
    "generate:brand-marks": "bun scripts/generate-brand-marks.ts",
    "check:brand-marks": "bun scripts/generate-brand-marks.ts --check",
    "generate:validators": "bun scripts/generate-validators.ts",
    "check:validators": "bun scripts/generate-validators.ts --check",
    "render:examples": "bun scripts/render-examples.ts"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "simple-icons": "16.28.0"
  },
  "overrides": {
    "fast-uri": "^3.1.7"
  }
}
