{
  "name": "schematics-repository",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "test": "bun test test/core-smoke.test.mjs",
    "test:browser": "bun scripts/run-browser-tests.ts",
    "test:generated": "bun run --cwd schematics check:viewer && bun run --cwd schematics check:brand-marks && bun run --cwd schematics check:validators && bun test/golden.mjs",
    "test:all": "bun test --timeout 120000",
    "test:full": "bun run test:generated && bun run test:all",
    "lint:boundaries": "depcruise packages schematics test scripts --exclude '(^|/)(node_modules|vendor|examples)/'"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "ajv": "^8.17.1",
    "dependency-cruiser": "^18.7.2",
    "parse5": "7.3.0",
    "saxes": "6.0.0",
    "skills": "1.7.0",
    "typescript": "^6",
    "yaml": "2.9.1"
  },
  "overrides": {
    "fast-uri": "^3.1.7"
  }
}
